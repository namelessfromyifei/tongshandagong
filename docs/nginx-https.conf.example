# 通山打拱 · 域名 + HTTPS 反代示例（www.zhangyuning.xyz）
# 用途：Nginx 全量反代 Node（Express + Socket.IO，本机 8080）。
# 证书：云厂商免费 DV（阿里云/腾讯云，一年期；到期在云控制台重签并替换，再 reload nginx）。
# 使用：
#   1) 证书放置：/etc/nginx/ssl/www.zhangyuning.xyz.pem 与 .key（云控制台下载后重命名）
#   2) 本文件放入 /etc/nginx/conf.d/tongshandagong.conf
#   3) sudo nginx -t && sudo systemctl reload nginx
#   4) 云安全组 + ufw 放行 443（80 用于跳转，建议一并放行）

# ---- 80 端口：一律 301 到 https://www.zhangyuning.xyz ----
# 同时覆盖裸域（zhangyuning.xyz）与 www；此块不需要证书
server {
    listen 80;
    listen [::]:80;
    server_name zhangyuning.xyz www.zhangyuning.xyz;
    return 301 https://www.zhangyuning.xyz$request_uri;
}

# ---- 443 端口：游戏主入口（www）----
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.zhangyuning.xyz;

    ssl_certificate     /etc/nginx/ssl/www.zhangyuning.xyz.pem;
    ssl_certificate_key /etc/nginx/ssl/www.zhangyuning.xyz.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Webhook 请求体必须原样透传：GitHub 签名是拿「原始请求体」算 HMAC。
    # proxy_pass 默认逐字节转发，满足要求；切勿开启 gzip 解压/改写后转发。
    client_max_body_size 1m;   # 与 server.js 的 express.raw(limit:'1mb') 对齐

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # Socket.IO(ws) 升级必需，否则对局/聊天长连接失败
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 关键：server.js 的 trust proxy=1 靠它识别 https（cookie Secure、协议判断等）
        proxy_set_header X-Forwarded-Proto $scheme;

        # Socket.IO 长连接：放宽超时与缓冲
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }
}

# 提示：
# - 若还想 https://zhangyuning.xyz（裸域也走 https）能访问：需再为裸域签一张证书，并加一个 443 块。
# - 8080 端口：Nginx 反代就绪后，云安全组/Ufw 可不再对外开 8080，Node 仅本机可达。