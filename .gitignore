node_modules/
npm-debug.log*
.playwright-mcp/
*.log
tests/*.json
.DS_Store

# 实际部署配置（含密钥，不提交）
ecosystem.config.js

# Android 构建产物与本机配置（工程本身要提交）
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
dist/
*.jks
*.keystore

# 联调截图（不入库）
shots/

# SQLite 数据（历史分数等持久化数据，不入库）
data/
*.db

# App 应用内更新：只提交 manifest.json；APK 经 release/latest.apk 入仓后由服务器部署时同步
app-update/*
!app-update/manifest.json
# 默认发布方式：APK 入仓（上面 *.apk 的例外），服务器 pull 后同步到 app-update/
!release/latest.apk
